{
  "name": "workout-log",
  "version": "2.11.2",
  "private": true,
  "type": "module",
  "description": "운동 일지 — 아이폰 홈 화면에 추가해서 쓰는 개인 운동 기록 PWA",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vite build && playwright test --trace off",
    "check": "npm run typecheck && npm run test && npm run build",
    "icons": "node scripts/make-icons.ts",
    "ex-art": "node scripts/make-ex-art.ts",
    "routine-art": "node scripts/make-routine-art.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.8",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
